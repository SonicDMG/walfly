# Astra DB
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...

# Docling (transcription)
# DOCLING_MODE=local  → runs docling directly via uv subprocess (default)
# DOCLING_MODE=saas   → IBM Docling for watsonx
DOCLING_MODE=local
DOCLING_UV_PROJECT=/tmp/video_to_openrag
DOCLING_SERVICE_URL=
DOCLING_API_KEY=

# LLM proxy (LiteLLM / OpenRouter — OpenAI-API-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o

# Vercel Blob storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Mobile app API base URL (Expo public env var)
EXPO_PUBLIC_API_URL=http://localhost:3000
