# ── API auth ─────────────────────────────────────────────────────────────────
# Single shared bearer token required on every /api/* request except
# /api/health and /api/wiki/*. The mobile app sends it as `Authorization:
# Bearer <token>` once entered on-device. Generate with: openssl rand -hex 32
WALFLY_API_TOKEN=

# ── Astra DB ────────────────────────────────────────────────────────────────
# Hybrid search (lexical + rerank) additionally requires a Serverless (vector)
# database in the AWS us-east-2 region. Everywhere else the app automatically
# falls back to vector search + searchTokens — nothing to configure.
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
# ASTRA_DB_KEYSPACE=default_keyspace          # optional

# ── Docling transcription sidecar ────────────────────────────────────────────
# Start the sidecar before running the API:
#   cd packages/api/sidecar && uv run python transcribe_sidecar.py
SIDECAR_URL=http://localhost:8888

# ── Streaming sidecar (live recording sessions) ──────────────────────────────
# Shared secret for the short-lived WebSocket tickets minted by
# POST /api/recordings/{id}/ws-ticket. Must match WALFLY_WS_SECRET on the
# sidecar host. Generate with: openssl rand -hex 32
WALFLY_WS_SECRET=
# Where the client opens the audio socket. The ticket response carries this URL
# to the app, so only the server needs it. Local default: ws://localhost:8888/v1/stream
# SIDECAR_WS_URL=wss://walfly-asr.fly.dev/v1/stream

# ── LLM proxy (OpenAI-API-compatible: LiteLLM, OpenRouter, Ollama) ──────────
# LLM_MODEL is REQUIRED — there is no default. A silently wrong default model
# is worse than a missing-config error.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# MUSIC_DETECTION_MODEL=google/gemini-2.5-flash-lite  # optional; defaults to LLM_MODEL
#                                             # Some models (gpt-oss-20b, claude) refuse to
#                                             # identify lyrics for copyright reasons — use a
#                                             # Gemini model here for reliable lyric detection.
# JEV_MODEL=~typesafe/jev-latest              # optional; model for fast moment classification
# LLM_JSON_MODE=auto                          # auto | on | off

# ── Audio storage ──────────────────────────────────────────────────────────
# Unset → local disk (packages/api/.data/audio), served by
# /api/recordings/audio/<name>. Fine for local dev; NOT recommended in
# production (an ephemeral or multi-instance container loses it on
# restart/redeploy). Set these for S3-compatible object storage — works
# identically against AWS S3, Cloudflare R2, Backblaze B2, or MinIO:
S3_ENDPOINT=                                  # unset = real AWS S3
S3_REGION=auto                                # 'auto' works for R2; a real region for AWS
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public-read base URL the bucket is reachable at (an R2 .r2.dev / custom
# domain, a MinIO public endpoint, or https://<bucket>.s3.<region>.amazonaws.com).
# The bucket itself must be configured for public read (bucket policy /
# public-access toggle) — this app never signs or re-signs URLs.
S3_PUBLIC_BASE_URL=
# LOCAL_AUDIO_DIR=                            # optional; default <cwd>/.data/audio
# MAX_UPLOAD_BYTES=                           # optional; default 100 000 000

# ── CORS ───────────────────────────────────────────────────────────────────
# "*" lets any origin reach the API — safe to leave as-is even once auth
# exists, since WALFLY_API_TOKEN (above) is the real boundary and CORS only
# governs what a *browser* enforces client-side. Set an explicit origin for
# extra hygiene if you want it.
CORS_ALLOW_ORIGIN=*

# LOCAL_AUDIO_DIR=                            # optional; default <cwd>/.data/audio


# ── Live codebase wiki (/wiki) ───────────────────────────────────────────────
# Optional. Raises the GitHub API rate limit from 60 req/hr (unauthenticated)
# to 5 000 req/hr (authenticated). Sufficient for local dev without a token.
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=
