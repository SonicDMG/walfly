# ── Astra DB ────────────────────────────────────────────────────────────────
# Hybrid search (lexical + rerank) additionally requires a Serverless (vector)
# database in the AWS us-east-2 region. Everywhere else the app automatically
# falls back to vector search + searchTokens — nothing to configure.
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
# ASTRA_DB_KEYSPACE=default_keyspace          # optional

# ── Whisper (transcription) ──────────────────────────────────────────────────
# Transcription uses the OpenAI Whisper API directly — no server required.
# By default WHISPER_API_KEY and WHISPER_BASE_URL fall back to LLM_API_KEY and
# LLM_BASE_URL, so if your LLM proxy also serves Whisper you need nothing extra.
#
# To use OpenAI directly for Whisper (recommended):
#   WHISPER_API_KEY=sk-...          # your OpenAI API key
#   # leave WHISPER_BASE_URL unset  # defaults to api.openai.com
#
# To use a different provider (e.g. Groq, which serves whisper-large-v3):
#   WHISPER_API_KEY=gsk_...
#   WHISPER_BASE_URL=https://api.groq.com/openai/v1
#   WHISPER_MODEL=whisper-large-v3
#
# WHISPER_MODEL defaults to "whisper-1" when unset.
# WHISPER_API_KEY=                          # falls back to LLM_API_KEY
# WHISPER_BASE_URL=                         # falls back to LLM_BASE_URL
# WHISPER_MODEL=whisper-1                   # optional override

# ── LLM proxy (OpenAI-API-compatible: LiteLLM, OpenRouter, Ollama) ──────────
# LLM_MODEL is REQUIRED — there is no default. A silently wrong default model
# is worse than a missing-config error.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-4o
# LLM_JSON_MODE=auto                          # auto | on | off

# ── Audio storage ──────────────────────────────────────────────────────────
# Unset in local dev → files land in packages/api/.data/audio and are served by
# /api/recordings/audio/<name>. REQUIRED on Vercel (read-only filesystem).
# Docling never fetches this URL: our server always uploads the bytes to it.
BLOB_READ_WRITE_TOKEN=

# ── CORS ───────────────────────────────────────────────────────────────────
# "*" is correct for this no-auth MVP and lets any Expo dev origin (port, LAN
# IP, tunnel) reach the API. Set an explicit origin once auth exists.
CORS_ALLOW_ORIGIN=*

# LOCAL_AUDIO_DIR=                            # optional; default <cwd>/.data/audio
