# Reference only. The one-step path is `./deploy.sh` — it generates every
# value marked (auto) below and prompts once for the handful marked
# (required) that no script can invent. Copy this to `.env` and fill it in
# by hand only if you'd rather skip deploy.sh entirely.
#
# Read by both services (via env_file) AND by docker-compose.yml itself for
# ${VAR} substitution. Separate from the per-package .env.local files
# packages/api and packages/api/sidecar use for non-Docker `npm run dev`.

# ── Domain / TLS ──────────────────────────────────────────────────────────────
# A real domain (DNS A record pointed at this machine) gets automatic HTTPS
# from Caddy for free. Leave blank to run over plain HTTP on this machine's
# IP for now — fine to start with, upgrade later by setting this and
# re-running ./deploy.sh.
DOMAIN=
# Caddy's own site address, derived from DOMAIN by deploy.sh (":80" when
# DOMAIN is blank, otherwise DOMAIN itself). Set directly only if you're
# skipping deploy.sh.
CADDY_ADDRESS=:80

# ── API auth (auto) ───────────────────────────────────────────────────────────
# openssl rand -hex 32
WALFLY_API_TOKEN=

# ── Astra DB (required) ────────────────────────────────────────────────────────
ASTRA_DB_API_ENDPOINT=https://<db-id>-<region>.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=AstraCS:...
# ASTRA_DB_KEYSPACE=default_keyspace

# ── Streaming, API <-> sidecar (auto + derived) ────────────────────────────────
# openssl rand -hex 32 — same value reaches both containers via this one file.
WALFLY_WS_SECRET=
# The sidecar's real public address, via Caddy. deploy.sh derives this from
# DOMAIN — wss://<domain>/v1/stream once DOMAIN is set, ws://localhost/v1/stream
# until then. Getting this wrong is the one trap that fails silently: every
# HTTP call still works fine while live streaming just never connects.
SIDECAR_WS_URL=ws://localhost/v1/stream

# ── ASR sidecar (auto) ──────────────────────────────────────────────────────────
# Baked into the sidecar image at build time (docker-compose.yml's build.args).
ASR_MODEL=small.en
# ASR_WORKERS=2
# ASR_CPU_THREADS=2

# ── LLM proxy (required: LLM_API_KEY; auto: the rest) ───────────────────────────
# OpenAI-API-compatible: LiteLLM, OpenRouter, Ollama.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# ── Audio storage ────────────────────────────────────────────────────────────────
# Self-hosted S3-compatible storage (Garage), bundled in docker-compose.yml —
# no external account needed. (Not MinIO: MinIO's images were pulled from
# Docker Hub and quay.io in September 2026 after the project was archived;
# Garage is the actively maintained replacement — see garage.toml.example.)
# deploy.sh generates these and points S3_* at the garage container
# automatically; also copy garage.toml.example to garage.toml (fill in a
# real rpc_secret) if you're configuring by hand.
GARAGE_DEFAULT_ACCESS_KEY=
GARAGE_DEFAULT_SECRET_KEY=
GARAGE_DEFAULT_BUCKET=walfly-audio
S3_BUCKET=walfly-audio
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public-read base URL, via Caddy's /media route (see Caddyfile — Garage's
# anonymous-read feature is Host-header-routed, so no bucket name in this
# path). deploy.sh derives this from DOMAIN the same way as SIDECAR_WS_URL.
S3_PUBLIC_BASE_URL=http://localhost/media
#
# To use real AWS S3 / Cloudflare R2 / Backblaze B2 instead of the bundled
# Garage: remove the `garage` and `garage-init` services from
# docker-compose.yml, then set S3_ENDPOINT (blank for AWS), S3_REGION,
# S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, and
# S3_PUBLIC_BASE_URL (that provider's own public base, bucket included)
# to that provider's values instead.

# ── CORS (auto) ─────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGIN=*

